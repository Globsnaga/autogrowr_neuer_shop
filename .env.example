# Kopieren nach ".env" und mit echten Werten füllen.
# ".env" ist bereits in .gitignore — nie echte Keys committen.

# URL des Medusa-Backends (siehe MEDUSA_SETUP.md). Lokal beim Entwickeln:
VITE_MEDUSA_BACKEND_URL=http://localhost:9000

# Store-API-Key aus dem Medusa-Admin: Einstellungen → Publishable API Keys
VITE_MEDUSA_PUBLISHABLE_KEY=

# Stripe Publishable Key (pk_test_… beim Testen, pk_live_… erst wenn live geschaltet wird)
VITE_STRIPE_PUBLISHABLE_KEY=
